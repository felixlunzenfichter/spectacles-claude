# Example environment configuration - Copy this to .env and fill in your values
# DO NOT put real secrets in this file

# Device secret - Generate a UUID and share it with your Spectacles client
# Both the Mac server and Spectacles client must use the SAME secret
# to find each other via the relay server
DEVICE_SECRET=your-uuid-here

# Relay server URL
RELAY_URL=https://your-project.deno.dev
